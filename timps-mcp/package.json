{
  "name": "@timps-ai/timps-mcp",
  "version": "2.0.2",
  "description": "MCP server for TIMPS — persistent memory, contradiction detection, bug patterns, burnout monitoring, and 70 tools for Claude Code, Cursor, and Windsurf",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "timps-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs --no-dts --out-dir dist",
    "start": "node dist/index.js",
    "typecheck": "node --max-old-space-size=4096 ../node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run"
  },
  "author": "TIMPS Contributors",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "memory",
    "timps",
    "claude",
    "claude-code",
    "cursor",
    "windsurf",
    "persistent-memory",
    "contradiction-detection",
    "burnout",
    "developer-tools",
    "ai-agent",
    "long-term-memory",
    "agentic",
    "openai",
    "gemini",
    "claude-code-alternative"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sandeeprdy1729/timps"
  },
  "homepage": "https://github.com/Sandeeprdy1729/timps/tree/main/timps-mcp",
  "bugs": {
    "url": "https://github.com/Sandeeprdy1729/timps/issues"
  },
  "dependencies": {
    "@timps-ai/memory-core": "*",
    "@modelcontextprotocol/sdk": "^1.10.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
