{
  "__inputs": [],
  "__requires": [],
  "title": "TIMPS — Multi-Agent Activity",
  "uid": "timps-agent-activity",
  "version": 3,
  "description": "Conflict detections (dedup/guard/chronos/write conflicts at store time), consolidation merge latency, and conflict checks",
  "schemaVersion": 39,
  "tags": ["timps", "agents"],
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "title": "Conflicts Detected",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(timps_crdt_conflict_detected_total[5m])", "legendFormat": "detected" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "title": "Conflict Checks",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "rate(timps_crdt_check_total[5m])", "legendFormat": "checks" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "title": "Consolidation Merge Latency p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(timps_crdt_merge_latency_bucket[5m]))",
        "legendFormat": "p95"
      }],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    }
  ]
}
