# TIMPS Server — Full Configuration
# Copy to .env and fill in the values you need.
# Ollama is the default provider and needs NO API key.
# You only need keys for providers you actually use.

# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=timps
POSTGRES_USER=postgres
# REQUIRED — the server ships with NO default password. Use a strong value
# in production, e.g. `openssl rand -base64 18`.
POSTGRES_PASSWORD=postgres

# ── Qdrant Vector DB (required for memory features) ───────
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=        # only needed if using Qdrant Cloud

# ── Web search ────────────────────────────────────────────
# web_search tries providers in order (comma-separated) so a down or
# rate-limited proxy falls back instead of silently failing.
#   ddg-api    — community DDG JSON proxy (default)
#   duckduckgo — official DuckDuckGo instant-answer API (no key)
#   custom     — your own endpoint (requires WEB_SEARCH_URL)
WEB_SEARCH_PROVIDERS=ddg-api,duckduckgo
# WEB_SEARCH_URL=             # custom provider endpoint (e.g. your SearXNG)
# WEB_SEARCH_API_KEY=         # optional Bearer token for custom provider

# ── File tool sandbox ─────────────────────────────────────
# The LLM-driven file_operations tool is sandboxed to the server's working
# directory by default. NEVER defaults to $HOME. To explicitly allow more
# directories, list them colon-separated (they are added to the cwd):
# TIMPS_FILE_BASE_DIRS=/srv/data:/var/backups

# ── Model Provider ────────────────────────────────────────
# Options: ollama | openai | anthropic | gemini | openrouter
DEFAULT_MODEL_PROVIDER=ollama

# ── Ollama (free, local — recommended) ────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b

# ── Anthropic (Claude) ────────────────────────────────────
# ANTHROPIC_API_KEY=

# ── OpenAI ────────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_DEFAULT_MODEL=gpt-4o-mini

# ── Google Gemini ─────────────────────────────────────────
# GEMINI_API_KEY=
# GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# ── OpenRouter (access 200+ models with one key) ──────────
# OPENROUTER_API_KEY=
# OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-haiku

# ── Embeddings ────────────────────────────────────────────
# Ollama embeddings are free and work offline.
# Switch to openai for higher quality at a cost.
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_DIMENSION=768

# ── Memory Tuning (optional) ──────────────────────────────
SHORT_TERM_TOKEN_LIMIT=4000
SHORT_TERM_MAX_MESSAGES=20
LONG_TERM_TOP_RESULTS=5

# ── External call timeouts / retries ──────────────────────
# Applied to all outbound calls (LLM providers, Qdrant, web fetch/search) so
# a hung dependency aborts instead of blocking the HTTP request indefinitely.
HTTP_TIMEOUT_MS=120000
HTTP_RETRIES=2
HTTP_BACKOFF_MS=1000
# Overall budget for the /chat agent loop (up to 15 sequential model calls).
AGENT_MAX_ITERATIONS=15
AGENT_TIME_LIMIT_MS=300000
